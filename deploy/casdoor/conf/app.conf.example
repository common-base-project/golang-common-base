appname = casdoor
httpport = 8000
runmode = prod
copyrequestbody = true

driverName = mysql
# 生产部署的 dataSourceName 由 docker-compose.casdoor-prod.yaml 中的环境变量覆盖。
dataSourceName = root:ChangeMe_StrongPassword@tcp(183.69.165.67:13306)/db_casdoor?charset=utf8mb4&parseTime=True&loc=Local

# 生产环境建议在反向代理层终止 TLS。
# 如果要启用 Casdoor HTTPS，请参考官方文档补齐 certFile/keyFile。
